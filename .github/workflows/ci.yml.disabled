name: CI Pipeline

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      
      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'   # Σύσταση: 3.10 για συμβατότητα με όλες τις βιβλιοθήκες

      # Java ΔΕΝ χρειάζεται για το Finance Automation project
      # (μόνο αν τρέχεις tests για το secondary intrusion detection)
      # Αν το secondary project έχει δικά του tests, καλύτερα να τα χωρίσεις σε ξεχωριστά jobs.
      # - name: Set up Java for PySpark Workloads
      #   uses: actions/setup-java@v3
      #   with:
      #     distribution: 'temurin'
      #     java-version: '17'
          
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install flake8 pytest
          if [ -f requirements_finance.txt ]; then pip install -r requirements_finance.txt; fi
          
      - name: Lint with flake8
        run: |
          flake8 finance_automation/ --count --select=E9,F63,F7,F82 --show-source --statistics
          
      - name: Run tests
        run: |
          pytest tests/ -v   # Συγκεκριμένος φάκελος tests, με verbose output